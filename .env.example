TAVILY_API_KEY=tvly-your-api-key
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_ENABLE_SEARCH=true
# basic costs 1 credit; advanced costs 2 credits.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10
TAVILY_CHUNKS_PER_SOURCE=2
# Tavily Search returns cleaned page content directly.
TAVILY_INCLUDE_RAW_CONTENT=markdown
TAVILY_TIMEOUT_MS=30000

MAX_SEARCH_TASKS=1
MAX_SEARCH_ROUNDS=2
MAX_RESEARCH_LANES=1
MAX_SOURCES_PER_ROUND=20
MAX_SOURCES_TO_JUDGE_PER_ROUND=10
MAX_SOURCE_EXCERPT_CHARS=420
SOURCE_CHUNK_CHARS=2000
SOURCE_CHUNK_OVERLAP_CHARS=240
MAX_CONTEXT_CHUNKS_PER_ROUND=24
SOURCE_JUDGE_CONTEXT_BUDGET_CHARS=60000
EXTRACT_CONTEXT_BUDGET_CHARS=120000
SYNTHESIZE_EVIDENCE_EXCERPT_CHARS=4000
SYNTHESIZE_READBACK_BUDGET_CHARS=60000
MAX_CONTEXT_READ_ROUNDS_PER_STAGE=2
MAX_CONTEXT_REQUESTS_PER_ROUND=6
MAX_CONTEXT_READ_CHARS_PER_REQUEST=8000
MAX_TAVILY_CREDITS_PER_RUN=2
MAX_MODEL_CALLS_PER_RUN=10
MAX_TOTAL_MODEL_TOKENS_PER_RUN=200000
MAX_WALL_TIME_SECONDS_PER_RUN=180
MAX_REPAIR_ROUNDS=2
MAX_REPAIR_ROUNDS_PER_CLAIM=1
JUDGE_MAX_OUTPUT_TOKENS=2048
EXTRACT_MAX_OUTPUT_TOKENS=2048
SYNTHESIZE_MAX_OUTPUT_TOKENS=8192

# Keep the expensive full extraction model off by default. Evidence is built
# deterministically from Tavily results and raw_content.
ENABLE_FULL_EXTRACTION_MODEL=false
